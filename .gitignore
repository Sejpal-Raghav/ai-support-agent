# Secrets and local environments
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Source data and generated local artifacts
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# LLM cache is local by default.
.llm_cache/

# Frontend build outputs
frontend/node_modules/
frontend/dist/
